# =========================================================================
# TỬ VI HỒNG ÂN - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Hướng dẫn bảo mật:
# 1. Sao chép tệp này thành '.env' trên máy chủ hoặc môi trường phát triển:
#    cp .env.example .env (Linux/macOS) hoặc Copy-Item .env.example .env (Windows)
# 2. Điền các giá trị thực tế (API Keys, Client Secrets, Firebase credentials).
# 3. Tuyệt đối KHÔNG commit tệp '.env' lên GitHub hoặc chia sẻ công khai.
# =========================================================================

# --- Frontend (Vite) Configuration ---
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_API_URL=/api

# --- Backend Server & Security Configuration ---
HOST=0.0.0.0
PORT=8080
CORS_ORIGIN=*
SECRET_KEY=your_production_secret_key_here

# --- Google OAuth Credentials (Backend) ---
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# --- Firebase Service Account Credentials ---
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# --- Authorization & Roles ---
MANAGER_EMAILS=admin@tuvihongan.com,quanly@tuvihongan.com
